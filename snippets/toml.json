{
  "jcargo": {
    "prefix": "jcargo",
    "body": [
      "[package]",
      "name = \"my_rust_project\"",
      "version = \"0.1.0\"",
      "edition = \"2021\"",
      "",
      "# Optional: Minimum Rust version",
      "rust-version = \"1.56\"",
      "",
      "[dependencies]",
      "rand = \"0.8\"",
      "serde = \"1.0\""
    ],
    "description": "snippet for cargo"
  },
  "jpytest": {
    "prefix": "jpytest",
    "body": [
      "[tool.pytest.ini_options]",
      "minversion = \"6.0\"",
      "addopts = \"-q\"",
      "testpaths = [",
      "\t\"tests\",",
      "]"
    ],
    "description": "hp snippet for pytest"
  },
  "jmypy": {
    "prefix": "jmypy",
    "body": [
      "[tool.mypy]",
      "mypy_path = \"src\"",
      "check_untyped_defs = true",
      "disallow_any_generics = true",
      "exclude = [\"venv\", \".venv\", \"alembic\"]",
      "no_implicit_optional = true",
      "show_error_codes = true",
      "strict_equality = true",
      "warn_redundant_casts = true",
      "warn_return_any = true",
      "warn_unreachable = true",
      "warn_unused_configs = true",
      "no_implicit_reexport = true"
    ],
    "description": "hp snippet for mypy"
  },
  "jflake8": {
    "prefix": "jflake8",
    "body": [
      "[tool.flakehell]",
      "exclude = [\"README.rst\", \"README.md\"]",
      "format = \"colored\"",
      "max_line_length = 88",
      "show_source = true",
      "whitelist = \"../../allowlist.txt\"",
      "",
      "[tool.flakehell.plugins]",
      "flake8-bandit = [\"+*\", \"-S322\"]",
      "flake8-bugbear = [\"+*\"]",
      "flake8-builtins = [\"+*\"]",
      "flake8-comprehensions = [\"+*\"]",
      "flake8-darglint = [\"+*\"]",
      "flake8-docstrings = [\"+*\"]",
      "flake8-eradicate = [\"+*\"]",
      "flake8-isort = [\"+*\"]",
      "flake8-mutable = [\"+*\"]",
      "flake8-pytest-style = [\"+*\"]",
      "flake8-spellcheck = [\"+*\"]",
      "mccabe = [\"+*\"]",
      "pep8-naming = [\"+*\"]",
      "pycodestyle = [\"+*\"]",
      "pyflakes = [\"+*\"]",
      "pylint = [\"+*\"]"
    ],
    "description": "hp snippet for flake8"
  },
  "jpylint": {
    "prefix": "jpylint",
    "body": [
      "[tool.pylint]",
      "disable = [",
      "\t\"C0114\", # missing-module-docstring",
      "\t\"C0115\", # missing-class-docstring",
      "\t\"C0116\", # missing-function-docstring",
      "\t\"C0301\", # line-too-long",
      "\t\"R0903\", # too-few-public-variables (< 2)",
      "\t\"R0911\", # too-many-return-statements (> 5)",
      "\t\"R0913\", # too-many-arguments (> 5)",
      "\t\"R0914\", # too-many-local-variables (> 15)",
      "\t\"R0917\", # too-many-positional-arguments (> 5)",
      "]"
    ],
    "description": "snippet for pylint config"
  },
  "jbuildpython": {
    "prefix": "jbuildpython",
    "body": [
      "[build-system]",
      "requires = [\"setuptools>=42.0\", \"wheel\"]",
      "build-backend = \"setuptools.build_meta\""
    ],
    "description": "hp snippet for build-system python"
  },
  "jmaturinpy": {
    "prefix": "jmaturinpy",
    "body": [
      "[build-system]",
      "requires = [\"maturin>=1.0,<2.0\"]",
      "build-backend = \"maturin\""
    ],
    "description": "snippet for maturin config (python)"
  },
  "jmaturinrust": {
    "prefix": "jmaturinrust",
    "body": [
      "[lib]",
      "# \"cdylib\" is necessary to produce a shared library for Python to import from.",
      "crate-type = [\"cdylib\"]",
      "",
      "[dependencies.pyo3]",
      "version = \"0.21.1\"",
      "# \"abi3-py38\" tells pyo3 (and maturin) to build using the stable ABI with minimum Python version 3.8",
      "features = [\"abi3-py38\"]"
    ],
    "description": "snippet for pyo3 config (rust)"
  },
  "jruff": {
    "prefix": "jruff",
    "body": [
      "[tool.ruff]",
      "builtins = [\"_\"]",
      "cache-dir = \"~/.ruff_cache\"",
      "exclude = [",
      "\t\".bzr\",",
      "\t\".direnv\",",
      "\t\".eggs\",",
      "\t\".git\",",
      "\t\".git-rewrite\",",
      "\t\".hg\",",
      "\t\".mypy_cache\",",
      "\t\".nox\",",
      "\t\".pants.d\",",
      "\t\".pytype\",",
      "\t\".ruff_cache\",",
      "\t\".svn\",",
      "\t\".tox\",",
      "\t\".venv\",",
      "\t\"__pypackages__\",",
      "\t\"_build\",",
      "\t\"buck-out\",",
      "\t\"dist\",",
      "\t\"node_modules\",",
      "\t\"venv\",",
      "]",
      "extend-exclude = []",
      "extend-include = []",
      "fix = false",
      "fix-only = false",
      "force-exclude = false",
      "include = [\"*.py\", \"*.pyi\", \"*.ipynb\", \"**/pyproject.toml\"]",
      "indent-width = 4",
      "line-length = 88",
      "namespace-packages = []",
      "output-format = \"full\"",
      "preview = false",
      "respect-gitignore = true",
      "show-fixes = false",
      "src = [\".\", \"src\"]",
      "",
      "[tool.ruff.lint]",
      "select = [",
      "\t\"E\",      # pycodestyle errors",
      "\t\"W\",      # pycodestyle warnings",
      "\t\"F\",      # pyflakes",
      "\t\"I\",      # isort",
      "\t\"B\",      # flake8-bugbear",
      "\t\"C4\",     # flake8-comprehensions",
      "\t\"UP\",     # pyupgrade",
      "\t\"ARG001\", # unused arguments in functions",
      "]",
      "ignore = [",
      "\t\"E501\", # line too long, handled by black",
      "\t\"B008\", # do not perform function calls in argument defaults",
      "\t\"W191\", # indentation contains tabs",
      "\t\"B904\", # Allow raising exceptions without from e, for HTTPException",
      "]",
      "",
      "[tool.ruff.lint.pyupgrade]",
      "# Preserve types, even if a file imports `from __future__ import annotations`.",
      "keep-runtime-typing = true",
      "",
      "[tool.pylint]",
      "disable = [",
      "  \"C0114\", # missing-module-docstring",
      "  \"C0115\", # missing-class-docstring",
      "  \"C0116\", # missing-function-docstring",
      "  \"C0301\", # line-too-long",
      "  \"R0903\", # too-few-public-variables (< 2)",
      "  \"R0911\", # too-many-return-statements (> 5)",
      "  \"R0913\", # too-many-arguments (> 5)",
      "  \"R0914\", # too-many-local-variables (> 15)",
      "  \"R0917\", # too-many-positional-arguments (> 5)",
      "]"
    ],
    "description": "snippet for ruff"
  },
  "jsqlfluff": {
    "prefix": "jsqlfluff",
    "body": [
      "[tool.sqlfluff.core]",
      "dialect = \"duckdb\"",
      "templater = \"jinja\"",
      "sql_file_exts = \".sql,.sql.j2,.dml,.ddl,.duckdb\"",
      "large_file_skip_byte_limit = 25000",
      "",
      "[tool.sqlfluff.indentation]",
      "indented_joins = false",
      "indented_using_on = true",
      "template_blocks_indent = false",
      "",
      "[tool.sqlfluff.templater]",
      "unwrap_wrapped_queries = true",
      "",
      "[tool.sqlfluff.templater.jinja]",
      "apply_dbt_builtins = true",
      "",
      "[tool.sqlfluff.rules.capitalisation.keywords]",
      "capitalisation_policy = \"lower\"",
      "",
      "[tool.sqlfluff.rules.capitalisation.literals]",
      "capitalisation_policy = \"lower\"",
      "",
      "[tool.sqlfluff.rules.capitalisation.functions]",
      "extended_capitalisation_policy = \"lower\"",
      "",
      "[tool.sqlfluff.rules.capitalisation.types]",
      "extended_capitalisation_policy = \"lower\"",
      "",
      "[tool.sqlfluff.rules.aliasing.length]",
      "min_alias_length = 3"
    ],
    "description": "snippet for sqlfluff"
  }
}
