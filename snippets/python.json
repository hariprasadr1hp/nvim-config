{
  "jaddarg": {
    "prefix": "jaddarg",
    "body": [
      "parser.add_argument(",
      "\t\"-${1:w}\",",
      "\t\"--${2:word}\",",
      "\ttype=${3:str},",
      "\trequired=${4:True},",
      "\tmetavar='',",
      "\thelp=\"${5:HELP-DOC}\"",
      ")$0"
    ],
    "description": "hp snippet for parser.add_argument"
  },

  "jargparse": {
    "prefix": "jargparse",
    "body": [
