# GDScript example to test editor settings

extends Node2D

# Declare variables
var name: String = "GDScript"
var speed: float = 200.0

# Called when the node enters the scene tree for the first time
func _ready():
    print("Hello, " + name + "!")
    print("Speed is set to: ", speed)

# Simple function to add two numbers
func add(a: int, b: int) -> int:
    return a + b

# Call the function
var result: int = add(5, 10)
print("Sum of 5 and 10: ", result)

# Handle input events (e.g., keyboard/mouse)
func _input(event):
    if event.is_action_pressed("ui_up"):
        print("Up key pressed")
    elif event.is_action_pressed("ui_down"):
        print("Down key pressed")

# Move an object based on input
func _process(delta: float):
    if Input.is_action_pressed("ui_right"):
        position.x += speed * delta
    if Input.is_action_pressed("ui_left"):
        position.x -= speed * delta

# Define a class with a method
class_name Player
var health: int = 100

func take_damage(amount: int):
    health -= amount
    print("Player health: ", health)

# Create an instance of the class
var player = Player.new()
player.take_damage(20)

# Signals example
signal my_signal(value)

func emit_signal_example():
    emit_signal("my_signal", 42)

func _on_my_signal_received(value):
    print("Signal received with value: ", value)

# Connect the signal
connect("my_signal", self, "_on_my_signal_received")
emit_signal_example()

